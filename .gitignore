# ============================================================================
# RayMod -- .gitignore
#
# ★★ 本仓库【只发布源码】。以下目录里的素材来自《明日方舟》（Arknights），
#    版权属鹰角网络（Hypergryph）等原权利人，**不可再分发** ——
#    因此绝不提交到公开仓库（见 README 的版权声明）。
#    克隆本仓库后无法直接构建出可用的模组，需要自备这些素材。
# ============================================================================

# ── 1) 第三方版权素材：绝对不提交 ────────────────────────────────────────────
# 明日方舟原音语音（中日双语，112 个 wav）
RayMod/audio/voice/
# 明日方舟原音效
RayMod/audio/sfx/
# 明日方舟 Spine 骨骼与贴图（角色 + 沙地兽，三套皮肤）
RayMod/spine/
# ⚠️ 根目录那套 spine/ 也是方舟素材（原皮骨架 + 贴图）—— 上面那条带前缀的匹配不到它，
#    必须单独写一条（本工程踩过：RayMod/spine/ 不匹配根目录 spine/）
/spine/
# 事件立绘
RayMod/images/events/

# ── 2) 衍生美术：含方舟元素，建议也不提交（你要公开就删掉这几行）────────────
# 卡面插画（AI 生成，参考了官方设定 —— 灰色地带）
RayMod/images/cards/
# 能力图标 / 角色立绘与 UI / 沙地兽 sprite
RayMod/images/powers/
RayMod/images/characters/
RayMod/images/monsters/
# 命中特效烘焙图集与中间素材
RayMod/vfx/
# 界面/特效贴图（从方舟素材转出来的，含官方元素）
RayMod/images/vfx/
# ⚠️ 注意：RayMod/images/relics/ 里的 4 张图标是**我们自己画的**（遗物图标），
#    配方里没有方舟元素，**保留**。

# ── 3) 本机专属配置：绝不能提交 ──────────────────────────────────────────────
# 里面是作者的 Steam / Godot 绝对路径。别人请复制 local.props.template 自行填写。
local.props

# ── 4) 构建产物 / 编辑器缓存（原本就有，保留）────────────────────────────────
bin/
obj/
.vs/
.idea/
.godot/
*.DotSettings
*.DotSettings.user
*.uid
*.import
*.tmp
*.log

# ── 5) 导出 / 打包产物：不应该进源码库 ──────────────────────────────────────
*.pck
*.dll
*.exe
RayMod.exe
RayMod.pck

# ── 6) 设计稿 / 个人素材（本工程里没有，防以后误加）──────────────────────────
_ref/
_preview/
_bake/
_build*/
_archive*/
*.psd
*.aseprite
